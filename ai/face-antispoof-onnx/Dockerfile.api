# ── Stage 1: Builder ─────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# System deps: OpenCV + curl for model download
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 curl && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.api.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.api.txt


# ── Stage 2: Model prep ───────────────────────────────────────────
# Download detector + train the scam model in a separate stage so
# the result is cached between code-only rebuilds.
FROM python:3.11-slim AS model-prep

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

# Copy everything needed to run download + training
COPY models/ ./models/
COPY ml/ ./ml/
COPY src/__init__.py ./src/__init__.py
COPY scripts/download_models.sh ./scripts/download_models.sh

# 1. Download detector_quantized.onnx (YuNet) if not already present in the COPY above
RUN bash scripts/download_models.sh

# 2. Train the scam detection model and save to models/scam_model.pkl
RUN python -m ml.train


# ── Stage 3: Runtime ─────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Runtime deps for OpenCV headless
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

# Copy installed packages
COPY --from=builder /install /usr/local

# Copy application code (only what's needed for inference)
COPY api/ ./api/
COPY src/inference/ ./src/inference/
COPY src/detection/ ./src/detection/
COPY src/__init__.py ./src/__init__.py
COPY ml/ ./ml/

# Copy trained/downloaded models from model-prep stage
COPY --from=model-prep /app/models/best_model_quantized.onnx ./models/best_model_quantized.onnx
COPY --from=model-prep /app/models/detector_quantized.onnx   ./models/detector_quantized.onnx
COPY --from=model-prep /app/models/scam_model.pkl            ./models/scam_model.pkl
COPY --from=model-prep /app/models/scam_model_metrics.json   ./models/scam_model_metrics.json

# Environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8000

EXPOSE ${PORT}

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT}/api/v1/health')" || exit 1

# Run with uvicorn
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
